<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>وضعیت چرخه</title>

<script src="https://cdn.jsdelivr.net/gh/jalaali/jalaali-js@1.1.3/dist/jalaali.min.js"></script>

<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600&display=swap');

body {
  font-family: 'Vazirmatn', sans-serif;
  background:#ffffff;
  margin:0;
  display:flex;
  justify-content:center;
  padding:20px;
  color:#0B3D91;
}

.container {
  max-width:440px;
  width:100%;
  background:#e6f0ff;
  border-radius:16px;
  padding:20px;
  box-shadow:0 6px 20px rgba(0,0,0,0.1);
  text-align:center;
}

h1, h2 { color:#0B3D91; }

#cycleBar { display:flex; justify-content:space-between; margin:20px 0; height:20px; border-radius:10px; overflow:hidden; background:#fff; border:1px solid #0B3D91; }
.day-block { flex:1; }
p { font-size:16px; margin:6px 0; }
</style>
</head>
<body>
<div class="container">
  <h1>وضعیت چرخه</h1>
  <p id="nextPeriodDisplay">پریود بعدی: -</p>
  <p id="nextPMSDisplay">PMS بعدی: -</p>
  <div id="cycleBar"></div>
</div>

<script>
function drawCycle(){
  const bar = document.getElementById('cycleBar');
  bar.innerHTML='';
  const today = new Date();
  const nextPeriod = localStorage.getItem('nextPeriod')? new Date(localStorage.getItem('nextPeriod')) : null;
  const nextPMS = localStorage.getItem('nextPMS')? new Date(localStorage.getItem('nextPMS')) : null;

  for(let i=0;i<30;i++){
    const day = new Date();
    day.setDate(today.getDate()+i);
    const div = document.createElement('div');
    div.classList.add('day-block');

    if(nextPMS && nextPeriod && day>=nextPMS && day<nextPeriod) div.style.background='#ffc0cb'; 
    else if(nextPeriod && day.toDateString()===nextPeriod.toDateString()) div.style.background='#0B3D91'; 
    else div.style.background='#cce0ff'; 

    bar.appendChild(div);
  }
}

function updateDisplay(){
  const nextP = localStorage.getItem('nextPeriod');
  const nextS = localStorage.getItem('nextPMS');

  if(nextP){
    const np = jalaali.toJalaali(new Date(nextP));
    document.getElementById('nextPeriodDisplay').textContent = `پریود بعدی: ${np.jy}/${np.jm}/${np.jd}`;
  }
  if(nextS){
    const ns = jalaali.toJalaali(new Date(nextS));
    document.getElementById('nextPMSDisplay').textContent = `PMS بعدی: ${ns.jy}/${ns.jm}/${ns.jd}`;
  }

  drawCycle();
}

window.addEventListener('load', updateDisplay);
</script>
</body>
</html>
